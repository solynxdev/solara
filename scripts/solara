#!/usr/bin/env bash
set -euo pipefail

SOLARA="${SOLARA_DIR:-$HOME/.config/solara}"
SOLARA_PID="$SOLARA/solara.pid"
SOLARA_VERSION="0.1.0"
QS="${QS:-$(command -v qs || true)}"

if [[ -z "$QS" ]]; then
    echo "solara: quickshell (qs) not found in PATH" >&2
    exit 1
fi

warn() { echo "solara: $*" >&2; }

usage() {
    cat <<'EOF'
solara — control the Solara Quickshell shell

Usage:
  solara <command> [args]

Commands:
  start,    -d    Start the shell (daemonized). No-op if already running.
  stop,     -k    Stop the shell. No-op if not running.
  restart,  -r    Stop the shell, then start it again.
  status,   -s    Show whether the shell is running (the shell.pid file keeps
                  the running pid for external consumers).
  log,      -l    Print/follow the shell log. Extra args are passed to
                  `qs log`, e.g. `solara log -f`.
  reload          Ask the running shell to reload itself via IPC.
  help,     -h    Show this help.
  version,  -V    Print the version.

Short flags may be used instead of the command name (solara -d, solara -k...).
EOF
}

version() {
    echo "Solara $SOLARA_VERSION"
}

shell_pid() {
    "$QS" list -p "$SOLARA" -j 2>/dev/null \
        | jq -r 'if length > 0 then .[0].pid else empty end' 2>/dev/null || true
}

shell_running() {
    local pid
    pid="$(shell_pid)"
    [[ -n "$pid" && "$pid" != "null" ]]
}

start_shell() {
    if shell_running; then
        warn "already running (pid $(shell_pid))"
        return 0
    fi

    "$QS" -n -p "$SOLARA" -d
    local pid
    for _ in $(seq 1 50); do
        pid="$(shell_pid)"
        if [[ -n "$pid" && "$pid" != "null" ]]; then
            echo "$pid" > "$SOLARA_PID"
            echo "solara: started (pid $pid)"
            return 0
        fi
        sleep 0.1
    done

    warn "started, but the shell did not register within 5s"
    return 1
}

stop_shell() {
    if ! shell_running; then
        warn "not running"
        rm -f "$SOLARA_PID"
        return 0
    fi

    "$QS" kill -p "$SOLARA" >/dev/null 2>&1 || true
    for _ in $(seq 1 50); do
        if ! shell_running; then
            rm -f "$SOLARA_PID"
            echo "solara: stopped"
            return 0
        fi
        sleep 0.1
    done

    warn "timed out waiting for the shell to exit"
    return 1
}

status_shell() {
    if shell_running; then
        echo "solara: running (pid $(shell_pid))"
        return 0
    fi
    if [[ -f "$SOLARA_PID" ]] && kill -0 "$(cat "$SOLARA_PID")" 2>/dev/null; then
        echo "solara: running (pid $(cat "$SOLARA_PID"), stale pidfile)"
        return 0
    fi
    echo "solara: not running"
    return 1
}

command="${1:-help}"
shift || true

case "$command" in
    start|-d)            start_shell ;;
    stop|-k)             stop_shell ;;
    restart|-r)          stop_shell && start_shell ;;
    status|-s)           status_shell ;;
    log|logs|-l)         "$QS" log -p "$SOLARA" "$@" ;;
    reload)              "$QS" ipc call solara reload ;;
    help|-h|--help)      usage ;;
    version|-V)          version ;;
    *)
        warn "unknown command: $command"
        usage
        exit 1
        ;;
esac